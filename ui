#!/bin/bash
# Starts BOTH halves: the Python engine (transcription + model) and the Next UI.
# One command, because two terminals for a personal tool is friction that compounds.
set -e
cd "$(dirname "$0")"
# A REMOTE ENGINE FIRST, if one is configured and answers (e.g. a PC with an NVIDIA GPU, see
# README "Running on an NVIDIA PC"). Its URL is one line in ~/.ytgist/remote or YTGIST_REMOTE.
# YTGIST_ENGINE=mac forces this Mac's own engine.
PC="${YTGIST_REMOTE:-$(cat "$HOME/.ytgist/remote" 2>/dev/null)}"
if [ "$YTGIST_ENGINE" != "mac" ] && [ -n "$PC" ] && curl -sf -m 2 -o /dev/null "$PC/api/limits"; then
  export YTGIST_ENGINE="$PC"
  echo "engine  → $PC  (the PC)"
else
  export YTGIST_ENGINE=""
  pkill -f "ytgist/serve.py" 2>/dev/null || true
  ./serve > /tmp/ytgist-serve.log 2>&1 &
  echo "engine  → http://127.0.0.1:8765  (log: /tmp/ytgist-serve.log)"
fi
cd web && exec npm run dev
